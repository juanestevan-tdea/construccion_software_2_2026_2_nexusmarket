# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env con credenciales reales al repositorio.

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=nexusmarket
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/nexusmarket?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true

# MongoDB
# Para Atlas usa una URI externa; no incrustes credenciales en archivos versionados.
MONGODB_URI=mongodb://localhost:27017/nexusmarket_audit

# JWT: obligatorio, mínimo 32 bytes aleatorios (se recomiendan 64).
# Genera uno con: openssl rand -base64 64
# o en PowerShell:
#   $b = New-Object byte[] 64
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
# El valor de ejemplo es deliberadamente corto para que la app falle si no se reemplaza.
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# Servidor
SERVER_PORT=8080

# Logging: deja SQL/Mongo en INFO salvo depuración local.
LOG_LEVEL=INFO
SQL_LOG_LEVEL=INFO
MONGODB_LOG_LEVEL=INFO
JPA_SHOW_SQL=false
