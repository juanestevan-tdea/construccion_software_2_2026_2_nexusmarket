# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env con credenciales reales al repositorio.

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=nexusmarket
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/nexusmarket?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexusmarket_audit

# JWT: mínimo 32 caracteres aleatorios (se recomiendan 64).
# Genera uno con: openssl rand -base64 64
JWT_SECRET=change-me-with-a-long-random-value

# Servidor
SERVER_PORT=8080
